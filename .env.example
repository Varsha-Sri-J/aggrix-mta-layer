# ==============================================================================
# AGGRIX Database Configuration Environment Variables
# ==============================================================================

# Primary PostgreSQL Connection URL
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/aggrix

# Test PostgreSQL Connection URL (used by pytest when running against live PG)
TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/aggrix_test

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_ECHO=false

