# ==============================================================================
# AGGRIX MTA Layer - Environment Configuration Template
# Copy this file to .env and adjust values for your local environment:
#   cp .env.example .env
# ==============================================================================

# Application Settings
PROJECT_NAME="AGGRIX MTA Layer"
ENVIRONMENT="development"
DEBUG=false
API_V1_STR="/api/v1"
BACKEND_PORT=8000

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aggrix_user
POSTGRES_PASSWORD=aggrix_password
POSTGRES_DB=aggrix_db

# Primary PostgreSQL Connection URL
# For local development outside Docker:
DATABASE_URL=postgresql+psycopg2://aggrix_user:aggrix_password@localhost:5432/aggrix_db
# For Docker Compose internal networking:
# DATABASE_URL=postgresql+psycopg2://aggrix_user:aggrix_password@db:5432/aggrix_db

# Test PostgreSQL Connection URL (used by pytest when running against live PostgreSQL)
TEST_DATABASE_URL=postgresql+psycopg2://aggrix_user:aggrix_password@localhost:5432/aggrix_db

# SQLAlchemy Connection Pool Configuration
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_ECHO=false

# JWT Authentication & Cryptographic Secret Key
# REQUIRED: Must be set in environment (.env or system env). Minimum 32 characters.
# DO NOT commit real secrets to version control.
JWT_SECRET_KEY=replace-with-a-secure-random-32-char-secret-for-local-dev-12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:8000

